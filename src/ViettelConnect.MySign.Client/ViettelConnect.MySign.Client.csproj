<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ViettelConnect.MySign.Client</RootNamespace>
    <AssemblyName>ViettelConnect.MySign.Client</AssemblyName>
    <PackageId>ViettelConnect.MySign</PackageId>
    <Version>0.1.0</Version>
    <Description>Community .NET SDK for Viettel MySign remote signing. Signs SHA256 hashes only: the signer approves each request in the MySign mobile app. Supports synchronous, status-polling and callback flows.</Description>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleReferencedProjects</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViettelConnect.MySign.Application\ViettelConnect.MySign.Application.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ViettelConnect.MySign.Domain\ViettelConnect.MySign.Domain.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ViettelConnect.MySign.Infrastructure\ViettelConnect.MySign.Infrastructure.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViettelConnect.MySign.UnitTests" />
    <InternalsVisibleTo Include="ViettelConnect.MySign.IntegrationTests" />
  </ItemGroup>

  <Target Name="BundleReferencedProjects" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BundledAssembly Include="@(ReferenceCopyLocalPaths)"
                       Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(BundledAssembly)" TargetPath="%(Filename)%(Extension)" />
      <BuildOutputInPackage Include="@(BundledAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
                            Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')"
                            TargetPath="%(Filename).pdb" />
    </ItemGroup>
  </Target>

</Project>
